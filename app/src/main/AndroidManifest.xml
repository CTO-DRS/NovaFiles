<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- الوصول إلى التخزين -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- الشبكة (للميزات المستقبلية: السحابة والمشاركة عبر FTP) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- v0.12: Wi-Fi Direct — اكتشاف الأجهزة القريبة والاقتران المباشر -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="32" />
    <!-- v0.41.1: إلزامي بجانب FINE وفق سياسة أندرويد — يسمح بمنح «الموقع التقريبي» بدل الرفض -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="32" />

    <!-- القفل الحيوي (بصمة/وجه) للخزنة المشفرة -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- v0.15: التقاط صورة تسلل اختيارية عند فشل دخول الخزنة -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- v0.41.1: الكاميرا اختيارية — التطبيق يعمل على أجهزة ChromeOS بلا كاميرا -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- المشاركة عبر WiFi: خدمة أمامية + إشعار -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".NovaApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.NovaFiles">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- v0.12: مصافحة النقل المباشر — مسح رمز QR يفتح اتصال الجهاز الآخر -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nova-direct" />
            </intent-filter>
            <!-- v0.16: عودة OAuth من المتصفح (Drive/Dropbox/OneDrive) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.novafiles.app" />
            </intent-filter>
            <!-- v0.17: ارتباطات الملفات — «فتح باستخدام NovaFiles» للنصوص والصور والأرشيفات -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-7z-compressed" />
                <data android:mimeType="application/x-rar-compressed" />
                <data android:mimeType="application/x-tar" />
                <data android:mimeType="application/gzip" />
            </intent-filter>
        </activity>

        <!-- v0.15: وضع التنكّر — أيقونة حاسبة في القاذف، تُفعّل من إعدادات الخزنة -->
        <activity-alias
            android:name="com.novafiles.app.LauncherCalc"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_calc_decoy"
            android:label="@string/calc_alias_label"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- مشاركة الملفات عبر WiFi — خادم FTP كخدمة أمامية -->
        <service
            android:name=".core.ftp.FtpServerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- v0.27 — خادم WebDAV المدمج كخدمة أمامية -->
        <service
            android:name=".core.davserver.WebDavServerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- v0.35 — مراقبة مجلدات قواعد الأتمتة كخدمة أمامية -->
        <service
            android:name=".core.rules.RuleWatcherService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- v0.17 — ودجات سطح المكتب الأربعة -->
        <receiver
            android:name=".widget.RecentFilesWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_recent_info" />
        </receiver>
        <receiver
            android:name=".widget.TransferWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_transfer_info" />
        </receiver>
        <receiver
            android:name=".widget.VaultWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_vault_info" />
        </receiver>
        <receiver
            android:name=".widget.StorageWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_storage_info" />
        </receiver>

        <!-- v0.12: العمليات الخلفية — خدمة أمامية للنسخ/النقل/الضغط خارج الشاشة -->
        <service
            android:name=".core.ops.OpService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- حفظ اختيار اللغة تلقائياً (تدويل عبر AppCompat) -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- مشاركة الملفات وفتحها مع تطبيقات أخرى -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
