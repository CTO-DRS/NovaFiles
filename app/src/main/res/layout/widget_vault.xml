<?xml version="1.0" encoding="utf-8"?>
<!-- v0.17 — ودجت الخزنة -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_vault_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_card"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_vault_title"
        android:textColor="#FFFFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_vault_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FF30D158"
        android:textSize="12sp"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/widget_vault_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#99EBEBF5"
        android:textSize="11sp"
        android:layout_marginTop="10dp" />
</LinearLayout>
