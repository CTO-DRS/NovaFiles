<?xml version="1.0" encoding="utf-8"?>
<!-- v0.17 — ودجت حالة النقل -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_transfer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_transfer_title"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_transfer_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#99EBEBF5"
        android:textSize="11sp"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/widget_transfer_current"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical">

        <TextView
            android:id="@+id/widget_transfer_speed"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="#99EBEBF5"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_transfer_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF0A84FF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
