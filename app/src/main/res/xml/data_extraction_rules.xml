<?xml version="1.0" encoding="utf-8"?>
<!--
    v0.41 — قواعد استخراج البيانات (Android 12+): النسخ الاحتياطي السحابي ونقل الجهاز-للجهاز.
    إصلاح P0 (تدقيق 2026-10-24): كانت القاعدة فارغة تماماً فتُدرج أسرار التطبيق
    في النسخ الاحتياطي السحابي وفي نقل الأجهزة على عكس قواعد API<=30.
    المستثنيات = كل مخازن الأسرار المثبتة بالتدقيق:
      - root/vault_key_notes.txt        : عبارة استعادة BIP39 نصاً صريحاً
      - sharedpref/nova_vault.xml       : رموز OAuth المشفرة (CredentialVault/KeystoreVault)
      - sharedpref/nova_vault2.xml      : المفتاح الجذر المغلف + مفتاح الخزنة الوهمية (Vault2Manager)
      - sharedpref/nova_known_hosts.xml : بصمات مضيفي SFTP (TOFU) — استبعاد يمنع حقن بصمة عبر استعادة
      - file/datastore/nova_settings.preferences_pb : تجزئات PIN + ملح الخزنة + كلمات مرور FTP/WebDAV
    المسموح بنسخه: التفضيلات غير الحساسة (nova_bookmarks، nova_rules، وسائط الودجات)
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="vault_key_notes.txt" />
        <exclude domain="sharedpref" path="nova_vault.xml" />
        <exclude domain="sharedpref" path="nova_vault2.xml" />
        <exclude domain="sharedpref" path="nova_known_hosts.xml" />
        <exclude domain="file" path="datastore/nova_settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="vault_key_notes.txt" />
        <exclude domain="sharedpref" path="nova_vault.xml" />
        <exclude domain="sharedpref" path="nova_vault2.xml" />
        <exclude domain="sharedpref" path="nova_known_hosts.xml" />
        <exclude domain="file" path="datastore/nova_settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
